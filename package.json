{
  "name": "@connorbritain/roadmap",
  "version": "0.7.2",
  "description": "Roadmap + backlog graph with conducted, independently evaluated cloud-agent execution. YAML canonical; GitHub is durable run reality.",
  "type": "module",
  "private": false,
  "author": "Connor England",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConnorBritain/roadmap.git"
  },
  "homepage": "https://github.com/ConnorBritain/roadmap#readme",
  "engines": {
    "node": ">=18.15"
  },
  "bin": {
    "roadmap": "scripts/cli.mjs"
  },
  "files": [
    "scripts/",
    "schema/",
    "README.md",
    "docs/DEPLOYMENT.md",
    "docs/GAUNTLET.md",
    "docs/EVIDENCE_PACKETS.md",
    "docs/EVALUATION_RUNBOOK.md",
    "docs/GAUNTLET_CONTINUATION.md",
    "docs/specs/trustworthy-gauntlet.md",
    "docs/qualification/",
    "skills/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "node scripts/cli.mjs",
    "plan": "node scripts/cli.mjs plan",
    "show": "node scripts/cli.mjs show",
    "fan": "node scripts/cli.mjs fan",
    "cleanup": "node scripts/cli.mjs cleanup",
    "validate": "node scripts/validate.mjs",
    "render": "node scripts/render.mjs",
    "mcp": "node scripts/mcp.mjs",
    "prepack": "npm test",
    "watch": "node scripts/watch-prs.mjs",
    "test": "node scripts/test/run.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "pack:all": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npm pack --workspaces --include-workspace-root --pack-destination dist",
    "test:packed": "node scripts/test/packed.mjs"
  },
  "dependencies": {
    "@connorbritain/roadmap-cli": "0.7.2",
    "@connorbritain/roadmap-core": "0.7.2",
    "@connorbritain/roadmap-exec-engineering": "0.7.2",
    "@connorbritain/roadmap-exec-general": "0.7.2",
    "yaml": "^2.5.0"
  }
}
